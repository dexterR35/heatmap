# Native mode uses persistent PGlite when DATABASE_URL is empty.
DATABASE_URL=
DATA_DIR=.local
DASHBOARD_PORT=3000
COLLECTOR_PORT=8080
DEMO_PORT=4173
DASHBOARD_ORIGIN=http://127.0.0.1:3000
DEMO_ORIGIN=http://127.0.0.1:4173
COLLECTOR_ORIGIN=http://127.0.0.1:8080
# Create an administrator with pnpm admin create-user (interactive).
# LOCAL_DEMO: local demo site and seed data. PRODUCTION: no demo, HTTPS origins required,
# and real sites collect only after an owner approves them in the dashboard.
RELEASE_STATUS=LOCAL_DEMO

# Set to "cloudflare" only when all traffic reaches Infrared through Cloudflare.
# Visitor IP (for rate limits, never stored) and country then come from Cloudflare's headers.
TRUSTED_EDGE=
# Addresses allowed to send those headers, besides loopback: e.g. the cloudflared
# container's Docker network. Comma-separated IPs or CIDR ranges.
TRUSTED_PROXIES=

# Private directory for logical backups; automatic backup starts OFF.
# Leave empty to use DATA_DIR/backups. Enable the daily schedule in Operations.
HEATMAP_BACKUP_DIR=
# Optional OTLP/HTTP metrics receiver, including /v1/metrics.
# HTTP is accepted only on loopback; use HTTPS for a remote receiver.
# Example: http://127.0.0.1:4318/v1/metrics
# No visitor data is sent to this endpoint. No exporter starts when empty.
HEATMAP_OTEL_METRICS_ENDPOINT=
